# Configurar en Vercel → Settings → Environment Variables (y en .env.local si desarrollas en tu PC).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # o NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SOLO servidor (nunca con prefijo NEXT_PUBLIC_): crear usuarios y cambiar contraseñas desde la app
SUPABASE_SERVICE_ROLE_KEY=eyJ...
