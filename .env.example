# Copiar a .env.local (desarrollo) y configurar en Vercel (producción).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # o NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SOLO servidor (nunca con prefijo NEXT_PUBLIC_): administración de usuarios y login por nombre de usuario
SUPABASE_SERVICE_ROLE_KEY=eyJ...
